{
  "name": "hq",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome check .",
    "test": "bun test ./packages ./apps/server ./apps/host --path-ignore-patterns='**/*.integration.test.ts'",
    "test:integration": "bun test --preload ./apps/server/src/integration-setup.ts .integration.test.ts",
    "dev": "COMPOSE_PROFILES=zero,gateway bun run stack:up && bun run --filter '@hq/server' --filter '@hq/web' dev",
    "test:e2e": "bun run --cwd apps/web test:e2e",
    "check:boundaries": "depcruise apps packages --config .dependency-cruiser.cjs",
    "check:bundle": "bun run --cwd apps/web build && bun scripts/check-bundle.ts",
    "check:all": "bun scripts/check-all.ts",
    "check:related": "bun scripts/check-related.ts",
    "stack:up": "docker compose -f infra/docker-compose.yml up -d --wait",
    "stack:down": "docker compose -f infra/docker-compose.yml --profile zero --profile gateway down",
    "db:migrate": "bun run stack:up && bun run --cwd packages/db migrate",
    "db:seed": "bun run stack:up && bun packages/db/src/postgres/seed.ts",
    "db:reset": "bun run stack:up && bun packages/db/src/postgres/seed.ts --reset",
    "db:generate-zero": "bun run --cwd packages/db generate-zero",
    "db:rebuild-messages": "bun apps/server/src/operator-cli.ts rebuild-messages",
    "jobs:failed": "bun apps/server/src/operator-cli.ts failed-jobs",
    "jobs:retry": "bun apps/server/src/operator-cli.ts retry-jobs",
    "tools:setup": "bun apps/server/src/operator-cli.ts tools-setup"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@swc/core": "^1.16.13",
    "@types/bun": "^1.4.2",
    "@types/react-dom": "19.3.0",
    "dependency-cruiser": "^18.5.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
