{
  "name": "hq",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome check .",
    "test": "bun test ./packages ./apps/server --path-ignore-patterns='**/*.integration.test.ts'",
    "test:integration": "bun test --preload ./packages/db/src/postgres/build-test-template.ts .integration.test.ts",
    "dev": "COMPOSE_PROFILES=zero bun run stack:up && bun run --filter '@hq/server' --filter '@hq/web' dev",
    "test:e2e": "bun run --cwd apps/web test:e2e",
    "check:boundaries": "depcruise apps packages --config .dependency-cruiser.cjs",
    "stack:up": "docker compose -f infra/docker-compose.yml up -d --wait",
    "stack:down": "docker compose -f infra/docker-compose.yml --profile zero down",
    "db:migrate": "bun run --cwd packages/db migrate",
    "db:seed": "bun packages/db/src/postgres/seed.ts",
    "db:reset": "bun packages/db/src/postgres/seed.ts --reset",
    "db:generate-zero": "bun run --cwd packages/db generate-zero"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@swc/core": "^1.16.13",
    "@types/bun": "^1.4.2",
    "dependency-cruiser": "^18.5.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
