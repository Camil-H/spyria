{
  "name": "@spyria/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "SPYRIA_TOKEN_SECRET=${SPYRIA_TOKEN_SECRET:-$(openssl rand -hex 32)} SPYRIA_SECRETS_KEY=${SPYRIA_SECRETS_KEY:-spyria-dev-secrets-key-0123456789abcdef} SPYRIA_OIDC_ISSUER=${SPYRIA_OIDC_ISSUER:-http://localhost:5556/dex} SPYRIA_OIDC_CLIENT_ID=${SPYRIA_OIDC_CLIENT_ID:-spyria} SPYRIA_OIDC_REDIRECT_URI=${SPYRIA_OIDC_REDIRECT_URI:-http://localhost:3000/auth/callback} SPYRIA_APP_ORIGIN=${SPYRIA_APP_ORIGIN:-http://localhost:5173} SPYRIA_GATEWAY_URL=${SPYRIA_GATEWAY_URL:-http://127.0.0.1:8180} SPYRIA_GATEWAY_ADMIN_USER=${SPYRIA_GATEWAY_ADMIN_USER:-spyria} SPYRIA_GATEWAY_ADMIN_PASSWORD=${SPYRIA_GATEWAY_ADMIN_PASSWORD:-spyria-dev-gateway} bun --watch src/index.ts",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.222.0",
    "@opentelemetry/context-async-hooks": "2.11.0",
    "@opentelemetry/core": "2.11.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-logs": "0.222.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@spyria/conversation": "workspace:*",
    "@spyria/db": "workspace:*",
    "@spyria/kernel": "workspace:*",
    "@spyria/profile": "workspace:*",
    "@spyria/runtime": "workspace:*",
    "@spyria/usage": "workspace:*",
    "@spyria/workspace": "workspace:*",
    "@rocicorp/zero": "1.9.0",
    "hono": "4.13.12",
    "jose": "6.2.12",
    "nodemailer": "10.0.13",
    "oauth4webapi": "3.8.8"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.2"
  }
}
