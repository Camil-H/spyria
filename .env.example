# Spyria environment. Copy to .env.dev for development (`bun run dev` and `bun run operator` read it; everything works
# without it in dev) or .env.prod for production (`docker compose --env-file .env.prod -f deploy/compose.prod.yml`).
# An empty value means unset. "Required in production" is checked at start when SPYRIA_ENV=production.
# [prod] marks what deploy/compose.prod.yml reads; it ignores every other key (it sets the gateway URL, the redirect URI,
# the auth mode and SPYRIA_ENV itself). Secrets: letters and digits only, for example `openssl rand -hex 32`.

# Core
# Unset in development. production: the server refuses to start until every "Required in production" setting is valid.
# SPYRIA_ENV=production
# [prod] Signs session tokens. Dev: a random value per `bun run dev`. Required in production, at least 32 characters.
SPYRIA_TOKEN_SECRET=
# [prod] Public origin of the app (setup link, GitHub callback, secure cookies). Required in production: https://.
SPYRIA_APP_ORIGIN=http://localhost:5173
# [prod] Encrypts stored secrets (SSO client secrets, GitHub App keys) and derives the key that reaches each runtime, at least 32 characters; change it only by rotating it (docs/guides/operations.md). Required; `bun run dev` sets a fixed dev value.
SPYRIA_SECRETS_KEY=
# Only while rotating SPYRIA_SECRETS_KEY: its previous values, comma-separated. They still open what they sealed and reach the runtimes started with them.
SPYRIA_PREVIOUS_SECRETS_KEYS=
# [prod] One-time setup token: only the sign-in link carrying it (<origin>/?setup=<token>, printed by `spyria setup` or
# `operator-cli.ts setup-link`) can create the first workspace; spent once one exists. Required in production, at least 32 characters.
SPYRIA_SETUP_TOKEN=
# [prod] One-time code (16 characters from ABCDEFGHJKMNPQRSTUVWXYZ23456789) that pairs this machine's runtime host (profile host)
# with the first workspace when it is created; set SPYRIA_HOST_CLAIM_URL=http://server:3000/h/<code> too. `spyria setup` sets both.
# SPYRIA_INSTALL_HOST_TOKEN=
# [prod] Rate limits key unauthenticated requests by client address: the socket address, or Cloudflare's CF-Connecting-IP
# header when the server is only reachable through Cloudflare, or x-forwarded-for:<n> behind a cloud load balancer that
# appends the client to X-Forwarded-For and is the only way in (n hops from the end: 1 for AWS and Azure, 2 for Google).
# Unset, cloudflare or x-forwarded-for:1 to 3.
# SPYRIA_TRUSTED_PROXY=cloudflare
# Agent runtime image; empty uses the one `bun run agent:build` recorded in apps/agent/image-id. The published server image
# carries the published runtime image of its own version, by digest, so hosts pull it.
SPYRIA_AGENT_IMAGE=
# zero-cache the server forwards /zero/* to (HTTP and WebSocket); unset in dev, where the app reaches zero-cache itself.
# Compose sets http://zero-cache:4848.
# SPYRIA_ZERO_URL=
# Server the web dev server proxies to.
SPYRIA_SERVER_URL=http://localhost:3000
# Built web app the server serves itself (one origin, production); unset in dev, where Vite serves it on 5173.
# SPYRIA_WEB_DIST=apps/web/dist
# [prod] Deployment name (lowercase letters, digits, dashes): prefixes every Docker object the app names, so two deployments
# share one Docker daemon: host container and state volume <name>-host, runtimes <name>-rt-*, sign-ins <name>-cred-*,
# harnesses <name>-harnesses. The Add host and sign-in commands carry it. In production it is also the Compose project and
# prefixes its containers, volumes and network: give it its own name (for example spyria-prod), never the dev stack's spyria.
SPYRIA_DEPLOYMENT=spyria

# Auth
# dex (dev and tests, one global issuer) or sso (the account apps below and each workspace's own provider). Required in
# production: sso.
SPYRIA_AUTH_MODE=dex
# dex mode: the Dex issuer and client. [prod] sso mode: an optional OIDC app of this Spyria that people sign in to their
# account with, besides Google and Microsoft; issuer, client id and secret are set together or not at all.
SPYRIA_OIDC_ISSUER=http://localhost:5556/dex
SPYRIA_OIDC_CLIENT_ID=spyria
# SPYRIA_OIDC_CLIENT_SECRET=
# <server origin>/auth/callback, registered at every provider. Required in production: on SPYRIA_APP_ORIGIN.
SPYRIA_OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
# [prod] Optional apps of this Spyria that people sign in to their account with, both with the redirect URI above: an
# OAuth client in Google Cloud (any Google account, Gmail included) and an app registration in Microsoft Entra for
# accounts in any organizational directory and personal Microsoft accounts. Anyone signed in can create a workspace; a
# workspace can require its own provider in Setup SSO, and workspaces on Google Workspace or Microsoft Entra sign in
# through these apps without entering a client id and secret. Each secret is required with its client id.
# SPYRIA_GOOGLE_CLIENT_ID=
# SPYRIA_GOOGLE_CLIENT_SECRET=
# SPYRIA_MICROSOFT_CLIENT_ID=
# SPYRIA_MICROSOFT_CLIENT_SECRET=

# Gateway (Bifrost)
SPYRIA_GATEWAY_URL=http://127.0.0.1:8180
# [prod] Admin login of the gateway. Required in production (both), not these development defaults.
SPYRIA_GATEWAY_ADMIN_USER=spyria
SPYRIA_GATEWAY_ADMIN_PASSWORD=spyria-dev-gateway
# [prod] Encrypts the members' API keys in the gateway; never change it without wiping the gateway's database. Required in production.
SPYRIA_GATEWAY_ENCRYPTION_KEY=spyria-dev-gateway-encryption-key
# [prod]
SPYRIA_GATEWAY_SETUP_TOKEN=spyria-dev-gateway-setup-token
# [prod] Password of the gateway's own database role.
SPYRIA_GATEWAY_DB_PASSWORD=spyria-dev-gateway-db
# OAuth redirect base of MCP servers set up in the gateway (served by the web dev server's proxy). Production: <origin>/gateway-oauth.
SPYRIA_GATEWAY_OAUTH_BASE=http://localhost:5173/gateway-oauth

# Production only (Compose)
# [prod] Version of the published images to run (a release tag without its v, for example 1.0.0). Required.
SPYRIA_VERSION=
# [prod] Registry and namespace the images (spyria-server, spyria-host, spyria-agent) were published under; default
# ghcr.io/camil-h. Only for a fork's own publication: the server and host images carry the namespace they were built for.
# SPYRIA_IMAGES=ghcr.io/camil-h
# [prod] Password of the spyria database role (set on the first start, kept in the Postgres volume).
SPYRIA_POSTGRES_PASSWORD=
# [prod] Admin password of zero-cache.
SPYRIA_ZERO_ADMIN_PASSWORD=
# [prod] Port on 127.0.0.1 where the server answers (health checks, a proxy on this machine); default 3300.
# SPYRIA_LOCAL_PORT=3300
# [prod] Optional services: host (the workspace runtime host) and cloudflare (Cloudflare Tunnel), comma-separated.
# COMPOSE_PROFILES=host,cloudflare
# [prod] Profile host: the claim URL of Workspace settings > Add runtime host, with its origin replaced by http://server:3000
# (http://server:3000/h/<code>); kept after the first pairing.
# SPYRIA_HOST_CLAIM_URL=
# [prod] Profile host: group owning the Docker socket: 0 on macOS, `stat -c %g /var/run/docker.sock` on Linux.
# SPYRIA_DOCKER_GROUP=0
# [prod] Profile cloudflare: the tunnel's token (Cloudflare Zero Trust > Networks > Tunnels).
# CLOUDFLARE_TUNNEL_TOKEN=

# Telemetry (OpenTelemetry). Logs are JSON lines on stdout in the server, the host and spyria-agent; traces and logs are
# also sent over OTLP/HTTP only when the endpoint is set (the host passes it to its runtimes).
# [prod]
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# [prod]
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20<token>
# Defaults: spyria-server, spyria-host, spyria-agent.
# OTEL_SERVICE_NAME=spyria-server
# Trace sampling in deploy/compose.prod.yml (server and host): 10% of new traces, children follow their parent.
# [prod]
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# [prod]
# OTEL_TRACES_SAMPLER_ARG=0.1

# Host (only when running spyria-host as a process: `bun apps/host/src/main.ts <claim url>`)
SPYRIA_HOST_STATE_DIR=.spyria-host
# The host reads SPYRIA_DEPLOYMENT above (the Add host command passes it when it is not spyria).
# Spyria marks the host offline after three heartbeats without one.
SPYRIA_HOST_HEARTBEAT_MS=30000
# Port of the model relay; unset: 4000 in a container, a free port as a process.
# SPYRIA_HOST_GATEWAY_PORT=4000
