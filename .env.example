# Spyria environment. Copy to .env: `bun run dev` and `bun run operator` read it; everything works without it in dev.
# An empty value means unset. "Required in production" is checked at start when SPYRIA_ENV=production.

# Core
# Unset in development. production: the server refuses to start until every "Required in production" setting is valid.
# SPYRIA_ENV=production
# Signs session tokens. Dev: a random value per `bun run dev`. Required in production, at least 32 characters.
SPYRIA_TOKEN_SECRET=
# Public origin of the app (links in emails, GitHub callback, secure cookies). Required in production: https://.
SPYRIA_APP_ORIGIN=http://localhost:5173
# Encrypts stored secrets (SSO client secrets, GitHub App keys), at least 32 characters; never change it. Required in production.
SPYRIA_SECRETS_KEY=
# Agent runtime image; empty uses the one `bun run agent:build` recorded in apps/agent/image-id.
SPYRIA_AGENT_IMAGE=
# Server the web dev server proxies to.
SPYRIA_SERVER_URL=http://localhost:3000

# Auth
# dex (dev and tests, one global issuer) or sso (each workspace's own provider). Required in production: sso.
SPYRIA_AUTH_MODE=dex
# Dex issuer and client (dex mode only).
SPYRIA_OIDC_ISSUER=http://localhost:5556/dex
SPYRIA_OIDC_CLIENT_ID=spyria
# <server origin>/auth/callback, registered at every provider. Required in production: on SPYRIA_APP_ORIGIN.
SPYRIA_OIDC_REDIRECT_URI=http://localhost:3000/auth/callback

# Mail
# SMTP for domain verification and invites, for example smtp://user:pass@smtp.example.com:587. Required in production.
SPYRIA_SMTP_URL=
# Sender, required when SMTP is set and in production, for example "Spyria <spyria@example.com>".
SPYRIA_MAIL_FROM=

# Gateway (Bifrost)
SPYRIA_GATEWAY_URL=http://127.0.0.1:8180
# Admin login of the gateway. Required in production (both), not these development defaults.
SPYRIA_GATEWAY_ADMIN_USER=spyria
SPYRIA_GATEWAY_ADMIN_PASSWORD=spyria-dev-gateway
# Encrypts the members' API keys in the gateway; never change it without wiping the gateway's database. Required in production.
SPYRIA_GATEWAY_ENCRYPTION_KEY=spyria-dev-gateway-encryption-key
SPYRIA_GATEWAY_SETUP_TOKEN=spyria-dev-gateway-setup-token
# Password of the gateway's own database role.
SPYRIA_GATEWAY_DB_PASSWORD=spyria-dev-gateway-db
# OAuth redirect base of MCP servers set up in the gateway (served by the web dev server's proxy).
SPYRIA_GATEWAY_OAUTH_BASE=http://localhost:5173/gateway-oauth

# Telemetry (OpenTelemetry). Logs are JSON lines on stdout in the server, the host and spyria-agent; traces and logs are
# also sent over OTLP/HTTP only when the endpoint is set (the host passes it to its runtimes).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20<token>
# Defaults: spyria-server, spyria-host, spyria-agent.
# OTEL_SERVICE_NAME=spyria-server

# Host (only when running spyria-host as a process: `bun apps/host/src/main.ts <claim url>`)
SPYRIA_HOST_STATE_DIR=.spyria-host
# Prefix of the host's Docker objects (runtimes spyria-rt-*, credential volumes spyria-cred-*).
SPYRIA_HOST_PREFIX=spyria-
SPYRIA_HOST_HEARTBEAT_MS=30000
# Port of the model relay; unset: 4000 in a container, a free port as a process.
# SPYRIA_HOST_GATEWAY_PORT=4000
