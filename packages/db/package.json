{
  "name": "@spyria/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/useQuery.tsx",
    "./server-writes": {
      "browser": "./src/server-writes.browser.ts",
      "default": "./src/server-writes.ts"
    },
    "./postgres": "./src/postgres.ts",
    "./testing": "./src/postgres/testing.ts",
    "./zero": "./src/zero.ts",
    "./zero-queries": "./src/zero-queries.ts",
    "./zero-store": "./src/zero-store.ts"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "generate": "drizzle-kit generate",
    "migrate": "bun src/postgres/migrate.ts",
    "generate-zero": "drizzle-zero generate --force --skip-builder -c drizzle-zero.config.ts -o src/zero.ts && biome format --write src/zero.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@spyria/kernel": "workspace:*",
    "@rocicorp/zero": "1.9.0",
    "drizzle-orm": "1.0.0-rc.4",
    "postgres": "3.4.9",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "react": "^19"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "drizzle-kit": "1.0.0-rc.4",
    "drizzle-zero": "1.0.0-beta.1",
    "react": "19.3.0"
  }
}
